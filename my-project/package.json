{
  "name": "goodlife-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test:local": "bash scripts/db-test-local.sh",
    "gen:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "gen:types:local": "supabase gen types typescript --db-url postgresql://root:localdev@localhost:5432/goodlife_test --schema public > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@ionic/react": "^9.0.13",
    "@serwist/next": "9.5.15",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "idb": "8.0.4",
    "ionicons": "^8.1.1",
    "next": "16.4.6",
    "next-intl": "4.15.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "serwist": "9.5.15",
    "supabase": "3.2.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
