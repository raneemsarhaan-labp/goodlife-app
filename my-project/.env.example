# Values printed by `npx supabase start` (local) or your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Server-only. Never expose to the browser. Used by completeJoin and admin uploads.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
